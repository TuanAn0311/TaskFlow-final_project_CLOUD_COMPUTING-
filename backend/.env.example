PORT=3000
# Number of trusted reverse-proxy hops. Render runs the API behind one proxy.
TRUST_PROXY_HOPS=0
# Set DATABASE_URL on managed hosts, or use the individual DB_* values locally.
DATABASE_URL=
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
JWT_SECRET=change_this_to_a_secure_random_secret
JWT_EXPIRY=7d
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
# Enable only when the PostgreSQL provider requires TLS.
DB_SSL=false
# Keep true unless the provider explicitly requires an unverified certificate.
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
# Private Supabase Storage bucket used for task documents and completion reports.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=taskflow-files
# Integration tests require this separate database URL; its database name must include a "test" segment.
TEST_DATABASE_URL=postgresql://postgres:your_test_db_password@localhost:5432/taskflow_test

# Optional bootstrap admin credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=System Administrator

# Optional development seed only; seed:dev refuses to run in production.
DEV_ADMIN_EMAIL=dev-admin@example.test
DEV_ADMIN_PASSWORD=
DEV_EMPLOYEE_PASSWORD=
